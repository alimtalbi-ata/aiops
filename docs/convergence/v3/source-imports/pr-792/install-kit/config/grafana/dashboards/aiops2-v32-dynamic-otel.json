    {
      "id": 6,
      "title": "Collector accepted log records",
      "type": "timeseries",
      "datasource": "ACME-Prometheus",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_receiver_accepted_log_records{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {

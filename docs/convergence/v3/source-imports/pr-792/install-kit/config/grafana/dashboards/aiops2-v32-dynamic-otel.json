{
  "uid": "aiops2-otel-pipeline-v32",
  "title": "AIOPS2 | Collector & Pipeline Health",
  "description": "Collector self-telemetry dashboard; empty until collector self-metrics are exported and scraped.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "editable": false,
  "tags": [
    "AIOPS2",
    "observability",
    "dynamic",
    "v32"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Collector job",
        "type": "query",
        "datasource": "ACME-Prometheus",
        "refresh": 2,
        "query": "label_values(up, job)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Collector telemetry",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "The OpenTelemetry Collector is running, but its **own Prometheus self-metrics have not been confirmed as scraped**. These queries intentionally show no data until exported and scraped."
      }
    },
    {
      "id": 2,
      "title": "Collector accepted spans",
      "type": "timeseries",
      "datasource": "ACME-Prometheus",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_receiver_accepted_spans{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Collector refused spans",
      "type": "timeseries",
      "datasource": "ACME-Prometheus",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_receiver_refused_spans{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Exporter sent spans",
      "type": "timeseries",
      "datasource": "ACME-Prometheus",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_sent_spans{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,

      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Collector refused log records",
      "type": "timeseries",
      "datasource": "ACME-Prometheus",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_receiver_refused_log_records{job=~\"$job\"}",
          "legendFormat": "{{job}}"

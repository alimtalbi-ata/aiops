# AIOPS2 - Exemple de configuration d'installation
# CANDIDAT PRIVE - NON DEPLOYABLE
#
# Copier vers .env uniquement lors d'une installation approuvee.
# Ne jamais publier un .env contenant des secrets.

# Base PostgreSQL applicative
AIOPS_DB_NAME=aiops2
AIOPS_DB_USER=aiops2
AIOPS_DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET

# Base PostgreSQL dediee a Temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=CHANGE_ME_GENERATE_DIFFERENT_STRONG_SECRET

# Temporal
TEMPORAL_NAMESPACE=aiops2
TEMPORAL_ADDRESS=temporal:7233

# Authentification interne AIOPS2
AIOPS_INTERNAL_TOKEN=CHANGE_ME_GENERATE_STRONG_SECRET
AIOPS_ADMIN_TOKEN=CHANGE_ME_GENERATE_DIFFERENT_STRONG_SECRET

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alimtalbi-ata/aiops/blob/main/docs/contracts/team-c-san-payments-run-journey.schema.json",
  "title": "AIOPS2 Team C SAN P1 to Payments Run Journey projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "mode",
    "run",
    "intelligence",
    "policy",
    "hitl",
    "worker",
    "receipt",
    "stage_plan",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "aiops.team-c.san-payments-run-journey.v2"
    },
    "scope": {
      "const": "STORY_OFFLINE"
    },
    "mode": {
      "const": "DEMO"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "incident_id",
        "tenant_id",
        "scenario_id",
        "executed_sha",
        "idempotency_key"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^SIM-ACME-[A-F0-9]{16}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^ACME-SIM-[A-F0-9]{16}$"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "null"
        },
        "scenario_id": {
          "const": "ACME-SAN-PAYMENTS"
        },
        "executed_sha": {
          "type": "null"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "analyst_status",
        "hypotheses",
        "critic_disposition",
        "objections",
        "critic_independently_verified",
        "evidence_refs"
      ],
      "properties": {
        "provider": {
          "const": "DETERMINISTIC_RULES_NOT_LLM"
        },
        "analyst_status": {
          "const": "HYPOTHESIS_ONLY"
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "confidence",
              "evidence_refs"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "null"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "critic_disposition": {
          "const": "HOLD_FOR_HUMAN_REVIEW"
        },
        "objections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critic_independently_verified": {
          "const": false
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes",
        "execution_allowed",
        "effect_allowed"
      ],
      "properties": {
        "decision": {
          "const": "DENY_LIVE_ACTION"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "execution_allowed": {
          "const": false
        },
        "effect_allowed": {
          "const": false
        }
      }
    },
    "hitl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "issuer",
        "human_approval_claimed",
        "simulated_only"
      ],
      "properties": {
        "kind": {
          "const": "SIMULATED_NOT_REQUESTED"
        },
        "approval_id": {
          "type": "null"
        },
        "issuer": {
          "const": "TWIN_ACME_SIMULATED"
        },
        "human_approval_claimed": {
          "const": false
        },
        "simulated_only": {
          "const": true
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "workflow_id",
        "task_queue",
        "isolated",
        "no_effect",
        "runtime_attested"
      ],
      "properties": {
        "executor": {
          "const": "NOT_INVOKED"
        },
        "workflow_id": {
          "type": "null"
        },
        "task_queue": {
          "type": "null"
        },
        "isolated": {
          "const": true
        },
        "no_effect": {
          "const": true
        },
        "runtime_attested": {
          "const": false
        }
      }
    },
    "receipt": {
      "type": "null"
    },
    "stage_plan": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "evidence_state",
          "run_id",
          "attempt_id",
          "sha256",
          "observed_at"
        ],
        "properties": {
          "stage": {
            "enum": [
              "capability_simulator",
              "capability_core",
              "capability_twin",
              "capability_policy",
              "capability_worker",
              "simulator_start",
              "pre_resolution_core",
              "pre_resolution_twin",
              "pre_resolution_policy",
              "pre_resolution_worker",
              "worker_no_effect",
              "core_finalization",
              "post_resolution_core",
              "post_resolution_twin",
              "post_resolution_policy",
              "post_resolution_worker",
              "resolved"
            ]
          },
          "status": {
            "const": "NOT_RUN"
          },
          "evidence_state": {
            "const": "MISSING"
          },
          "run_id": {
            "type": "string",
            "pattern": "^SIM-ACME-[A-F0-9]{16}$"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^ACME-SIM-[A-F0-9]{16}$"
          },
          "sha256": {
            "type": "null"
          },
          "observed_at": {
            "type": "null"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_sha256",
        "source_git_sha",
        "expected_sha",
        "collected_at"
      ],
      "properties": {
        "source_kind": {
          "const": "LOCAL_SYNTHETIC_FIXTURE"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_git_sha": {
          "type": "null"
        },
        "expected_sha": {
          "type": "null"
        },
        "collected_at": {
          "type": "null"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alimtalbi-ata/aiops/blob/main/docs/contracts/team-c-san-payments-run-journey.schema.json",
  "title": "AIOPS2 Team C SAN P1 to Payments Run Journey",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "mode",
    "run",
    "intelligence",
    "policy",
    "hitl",
    "worker",
    "receipt",
    "stage_evidence",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "aiops.team-c.san-payments-run-journey.v1"
    },
    "scope": {
      "enum": [
        "STORY_OFFLINE",
        "RUNTIME_SANDBOX"
      ]
    },
    "mode": {
      "enum": [
        "DEMO",
        "SIMULATION"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "incident_id",
        "tenant_id",
        "scenario_id",
        "executed_sha",
        "idempotency_key"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^ACME-SIM-[A-F0-9]{16}$"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario_id": {
          "const": "ACME-SAN-PAYMENTS"
        },
        "executed_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "analyst_status",
        "hypotheses",
        "critic_disposition",
        "objections",
        "critic_independently_verified",
        "evidence_refs"
      ],
      "properties": {
        "provider": {
          "const": "DETERMINISTIC_RULES_NOT_LLM"
        },
        "analyst_status": {
          "const": "HYPOTHESIS_ONLY"
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "confidence",
              "evidence_refs"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "critic_disposition": {
          "const": "HOLD_FOR_HUMAN_REVIEW"
        },
        "objections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critic_independently_verified": {
          "const": false
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes",
        "execution_allowed",
        "effect_allowed"
      ],
      "properties": {
        "decision": {
          "enum": [
            "DENY_LIVE_ACTION",
            "SIMULATE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_allowed": {
          "const": false
        },
        "effect_allowed": {
          "const": false
        }
      }
    },
    "hitl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "issuer",
        "human_approval_claimed",
        "simulated_only"
      ],
      "properties": {
        "kind": {
          "const": "SIMULATED"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^SIM-APP-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "issuer": {
          "const": "TWIN_ACME_SIMULATED"
        },
        "human_approval_claimed": {
          "const": false
        },
        "simulated_only": {
          "const": true
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "workflow_id",
        "task_queue",
        "isolated",
        "no_effect",
        "runtime_attested"
      ],
      "properties": {
        "executor": {
          "const": "TEMPORAL"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "task_queue": {
          "type": "string",
          "minLength": 1
        },
        "isolated": {
          "const": true
        },
        "no_effect": {
          "const": true
        },
        "runtime_attested": {
          "type": "boolean"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sha256",
        "status",
        "reason",
        "ticket_id",
        "stages"
      ],
      "properties": {
        "schema": {
          "const": "aiops.debian-acme-sim-e2e.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "PASS"
        },
        "reason": {
          "const": "SIMULATED_SANDBOX_ONLY"
        },
        "ticket_id": {
          "type": "string",
          "pattern": "^SIM-GLPI-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_simulator",
            "capability_core",
            "capability_twin",
            "capability_policy",
            "capability_worker",
            "simulator_start",
            "pre_resolution_core",
            "pre_resolution_twin",
            "pre_resolution_policy",
            "pre_resolution_worker",
            "worker_no_effect",
            "core_finalization",
            "post_resolution_core",
            "post_resolution_twin",
            "post_resolution_policy",
            "post_resolution_worker",
            "resolved"
          ],
          "properties": {
            "capability_simulator": {
              "const": "PASS"
            },
            "capability_core": {
              "const": "PASS"
            },
            "capability_twin": {
              "const": "PASS"
            },
            "capability_policy": {
              "const": "PASS"
            },
            "capability_worker": {
              "const": "PASS"
            },
            "simulator_start": {
              "const": "PASS"
            },
            "pre_resolution_core": {
              "const": "PASS"
            },
            "pre_resolution_twin": {
              "const": "PASS"
            },
            "pre_resolution_policy": {
              "const": "PASS"
            },
            "pre_resolution_worker": {
              "const": "PASS"
            },
            "worker_no_effect": {
              "const": "PASS"
            },
            "core_finalization": {
              "const": "PASS"
            },
            "post_resolution_core": {
              "const": "PASS"
            },
            "post_resolution_twin": {
              "const": "PASS"
            },
            "post_resolution_policy": {
              "const": "PASS"
            },
            "post_resolution_worker": {
              "const": "PASS"
            },
            "resolved": {
              "const": "PASS"
            }
          }
        }
      }
    },
    "stage_evidence": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "issuer",
          "sha256",
          "observed_at",
          "run_id",
          "attempt_id"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "const": "PASS"
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^ACME-SIM-[A-F0-9]{16}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_sha256",
        "expected_sha",
        "collected_at"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "LOCAL_SYNTHETIC_FIXTURE",
            "AUTHENTICATED_SANDBOX_READBACK"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "STORY_OFFLINE"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "DEMO"
          },
          "run": {
            "properties": {
              "tenant_id": {
                "type": "null"
              },
              "run_id": {
                "pattern": "^SIM-ACME-"
              }
            }
          },
          "worker": {
            "properties": {
              "runtime_attested": {
                "const": false
              }
            }
          },
          "provenance": {
            "properties": {
              "source_kind": {
                "const": "LOCAL_SYNTHETIC_FIXTURE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "RUNTIME_SANDBOX"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "SIMULATION"
          },
          "run": {
            "properties": {
              "tenant_id": {
                "const": "ACME-TEST"
              }
            }
          },
          "provenance": {
            "properties": {
              "source_kind": {
                "const": "AUTHENTICATED_SANDBOX_READBACK"
              }
            }
          }
        }
      }
    }
  ]
}

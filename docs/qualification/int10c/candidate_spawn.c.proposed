/* Inert candidate, never compiled or invoked by current CI.
 * Trusted dedicated VM supervisor only. No standalone entrypoint.
 * Parent owns prevalidated executable fd, cgroup fd, argv/env, uid/gid.
 * Child cannot execute until placed by kernel in target cgroup.
 */
#define _GNU_SOURCE
#include <linux/sched.h>
#include <sys/syscall.h>
#include <sys/types.h>
#include <sys/prctl.h>
#include <unistd.h>
#include <grp.h>
#include <errno.h>
#include <stdint.h>
#include <signal.h>

/* Returns child PID and pidfd to supervisor; no fallback.
 * External admission MUST verify exclusive cgroup, VM, image, descriptors,
 * non-root target identity, empty supplementary groups policy, no escape,
 * sterile environment, deadline and independent watchdog before invocation.
 * Single-threaded trusted launcher only; inherited fd allowlist mandatory.
 * Partial child ownership recorded by outer supervisor at reservation time.
 */
pid_t candidate_spawn(int domain_fd, int exec_fd, uid_t uid, gid_t gid,
                      char *const argv[], char *const envp[], int *pidfd_out)
{
#if defined(SYS_clone3) && defined(CLONE_INTO_CGROUP) && defined(CLONE_PIDFD)
    if (domain_fd < 3 || exec_fd < 3 || domain_fd == exec_fd ||
        uid == 0 || gid == 0 || !argv || !argv[0] || !envp || !pidfd_out) {
        errno = EINVAL;
        return -1;
    }
    int childfd = -1;
    *pidfd_out = -1;
    struct clone_args args = {0};
    args.flags = CLONE_INTO_CGROUP | CLONE_PIDFD;
    args.cgroup = (uint64_t)domain_fd;
    args.pidfd = (uint64_t)(uintptr_t)&childfd;
    args.exit_signal = SIGCHLD;
    long result = syscall(SYS_clone3, &args, sizeof(args));
    if (result == 0) {
        if (close(domain_fd) < 0 ||
            prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0 ||
            setgroups(0, 0) < 0 || setresgid(gid,gid,gid) < 0 ||
            setresuid(uid,uid,uid) < 0)
            _exit(126);
        fexecve(exec_fd, argv, envp);
        _exit(127);
    }
    if (result < 0) return -1;
    *pidfd_out = childfd;
    return (pid_t)result;
#else
    errno = ENOSYS;
    return -1;
#endif
}

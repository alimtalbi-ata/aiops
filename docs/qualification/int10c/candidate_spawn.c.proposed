/* Inert candidate, never compiled or invoked by current CI.
 * Trusted dedicated VM supervisor only. No standalone entrypoint.
 * Parent owns prevalidated executable fd, cgroup fd, argv/env, uid/gid.
 * Child cannot execute until placed by kernel in target cgroup.
 */
#define _GNU_SOURCE
#include <linux/sched.h>
#include <sys/syscall.h>
#include <sys/types.h>
#include <sys/prctl.h>
#include <unistd.h>
#include <grp.h>
#include <errno.h>
#include <stdint.h>
#include <signal.h>
#include <linux/capability.h>
#include <linux/securebits.h>
#include <fcntl.h>
#include <limits.h>

/* Child retains only standard streams (externally verified) and executable fd.
 * Require close_range and CLOEXEC executable; no compatibility fallback.
 * Executable must be a native immutable ELF, not an interpreter script.
 */
static int restrict_fds(int exec_fd)
{
#if defined(SYS_close_range)
    if (fcntl(exec_fd, F_SETFD, FD_CLOEXEC) < 0) return -1;
    if (exec_fd > 3 && syscall(SYS_close_range, 3U,
                              (unsigned int)exec_fd - 1U, 0U) < 0) return -1;
    if (syscall(SYS_close_range, (unsigned int)exec_fd + 1U, UINT_MAX, 0U) < 0)
        return -1;
    return 0;
#else
    errno = ENOSYS;
    return -1;
#endif
}

/* Require an already constrained bounding set; do not guess kernel cap_last_cap.
 * Trusted supervisor must establish and independently verify the empty set.
 */
static int check_privilege_baseline(void)
{
    int bits = prctl(PR_GET_SECUREBITS, 0, 0, 0, 0);
    if (bits < 0 || (bits & (SECBIT_KEEP_CAPS | SECBIT_NO_SETUID_FIXUP)))
        return -1;
    for (int cap = 0; cap <= 1024; ++cap) {
        int value = prctl(PR_CAPBSET_READ, cap, 0, 0, 0);
        if (value < 0)
            return cap > CAP_LAST_CAP && errno == EINVAL ? 0 : -1;
        if (value != 0) return -1;
    }
    return -1;
}

static int clear_caps(void)
{
#if defined(SYS_capset) && defined(SYS_capget) && defined(PR_CAP_AMBIENT_CLEAR_ALL)
    struct __user_cap_header_struct h = {_LINUX_CAPABILITY_VERSION_3, 0};
    struct __user_cap_data_struct d[2] = {{0}};
    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0) < 0 ||
        syscall(SYS_capset, &h, d) < 0 ||
        syscall(SYS_capget, &h, d) < 0) return -1;
    for (int i = 0; i < 2; ++i)
        if (d[i].effective || d[i].permitted || d[i].inheritable) return -1;
    return 0;
#else
    errno = ENOSYS;
    return -1;
#endif
}

/* Returns child PID and pidfd to supervisor; no fallback.
 * External admission MUST verify exclusive cgroup, VM, image, descriptors,
 * non-root target identity, empty supplementary groups policy, no escape,
 * sterile environment, deadline and independent watchdog before invocation.
 * Single-threaded trusted launcher only; inherited fd allowlist mandatory.
 * Partial child ownership recorded by outer supervisor at reservation time.
 */
pid_t candidate_spawn(int domain_fd, int exec_fd, uid_t uid, gid_t gid,
                      char *const argv[], char *const envp[], int *pidfd_out)
{
#if defined(SYS_clone3) && defined(CLONE_INTO_CGROUP) && defined(CLONE_PIDFD)
    if (domain_fd < 3 || exec_fd < 3 || domain_fd == exec_fd ||
        uid == 0 || gid == 0 || uid == (uid_t)-1 || gid == (gid_t)-1 || !argv || !argv[0] || !envp || !pidfd_out) {
        errno = EINVAL;
        return -1;
    }
    int childfd = -1;
    *pidfd_out = -1;
    struct clone_args args = {0};
    args.flags = CLONE_INTO_CGROUP | CLONE_PIDFD;
    args.cgroup = (uint64_t)domain_fd;
    args.pidfd = (uint64_t)(uintptr_t)&childfd;
    args.exit_signal = SIGCHLD;
    long result = syscall(SYS_clone3, &args, sizeof(args));
    if (result == 0) {
        if (check_privilege_baseline() < 0 || restrict_fds(exec_fd) < 0 ||
            prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0 ||
            setgroups(0, 0) < 0 || setresgid(gid,gid,gid) < 0 ||
            setresuid(uid,uid,uid) < 0 || clear_caps() < 0)
            _exit(126);
        fexecve(exec_fd, argv, envp);
        _exit(127);
    }
    if (result < 0) return -1;
    *pidfd_out = childfd;
    return (pid_t)result;
#else
    errno = ENOSYS;
    return -1;
#endif
}

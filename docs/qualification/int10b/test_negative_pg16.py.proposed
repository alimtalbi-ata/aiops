"""Inert test mixin, NOT_TESTED. SQL structure only, never authority."""
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from uuid import uuid4
import psycopg

class NegativeContract:
    def test_ownership_fork_and_revocation(self):
        rid='B8-'+uuid4().hex
        now=datetime.now(timezone.utc)-timedelta(seconds=10)
        with self.connect() as c:
            c.execute("insert into aiops.int10b_ownership_identity values ('run',%s,'ACME-TEST')",(rid,))
        def append(version, predecessor, event='VERIFIED', tenant='ACME-TEST'):
            oid=uuid4().hex
            at=now+timedelta(seconds=version)
            with self.connect() as c:
                c.execute("""insert into aiops.int10b_ownership_observation
                    (observation_id,resource_kind,resource_id,tenant_id,source_event_id,
                     observation_version,predecessor_id,event_type,observed_at,known_at,
                     producer_id,key_id,source_payload_sha256,proof_format,proof_bytes)
                    values (%s,'run',%s,%s,%s,%s,%s,%s,%s,%s,'fixture','fixture',%s,'UNVERIFIED_FIXTURE',%s)""",
                    (oid,rid,tenant,oid,version,predecessor,event,at,at,'0'*64,b'not-a-proof'))
            return oid
        first=append(1,None)
        def compete(_):
            try:
                return append(2,first)
            except psycopg.Error as exc:
                if exc.sqlstate not in ('P0001','23505','40001'):
                    raise
                return None
        with ThreadPoolExecutor(max_workers=2) as pool:
            winners=[x for x in pool.map(compete,range(2)) if x]
        self.assertEqual(len(winners),1)
        with self.assertRaises(psycopg.Error):
            append(3,winners[0],tenant='FOREIGN')
        revoked=append(3,winners[0],'REVOKED')
        with self.assertRaises(psycopg.Error):
            append(4,revoked)
        with self.connect() as c:
            self.assertEqual(c.execute("""select event_type from aiops.int10b_ownership_observation
                where resource_kind='run' and resource_id=%s order by observation_version desc""",(rid,)).fetchall(),
                [('REVOKED',),('VERIFIED',),('VERIFIED',)])

    def test_outbox_illegal_transitions(self):
        # Runner supplies structurally valid synthetic REJECT row via B2 guards;
        # never an authenticated human decision.
        event=self.seed_reject_pending()
        def update(statement, args=()):
            with self.connect() as c:
                c.execute(statement,(*args,event))
        with self.assertRaises(psycopg.Error):
            update("update aiops.hitl_decision_outbox set status='DEAD' where event_id=%s")
        update("""update aiops.hitl_decision_outbox set status='LEASED',attempts=1,
            lease_owner='fixture',lease_token=%s,lease_until=clock_timestamp()+interval '30 seconds'
            where event_id=%s""",(uuid4().hex,))
        with self.assertRaises(psycopg.Error):
            update("""update aiops.hitl_decision_outbox set attempts=2,lease_token=%s,
                lease_until=clock_timestamp()+interval '30 seconds' where event_id=%s""",(uuid4().hex,))
        update("update aiops.hitl_decision_outbox set status='DELIVERED',delivered_at=clock_timestamp() where event_id=%s")
        with self.assertRaises(psycopg.Error):
            update("update aiops.hitl_decision_outbox set status='LEASED',delivered_at=null where event_id=%s")
        with self.connect() as c:
            self.assertEqual(c.execute("select status,attempts from aiops.hitl_decision_outbox where event_id=%s",(event,)).fetchone(),('DELIVERED',1))

    def test_dead_requires_atomic_receipt(self):
        # Fixture must reach eight genuine expired leases through B6, no trigger bypass.
        event, receipt=self.seed_eighth_expired_lease()
        with self.assertRaises(psycopg.Error):
            with self.connect() as c:
                c.execute("update aiops.hitl_decision_outbox set status='DEAD' where event_id=%s",(event,))
        with self.connect() as c:
            self.assertEqual(c.execute("select status from aiops.hitl_decision_outbox where event_id=%s",(event,)).fetchone(),('LEASED',))
        with self.connect() as c:
            c.execute("update aiops.hitl_decision_outbox set status='DEAD' where event_id=%s",(event,))
            self.insert_fixture_receipt(c,receipt)
        with self.connect() as c:
            self.assertEqual(c.execute("""select o.status,count(t.event_id) from aiops.hitl_decision_outbox o
                left join aiops.hitl_reject_terminal_receipts t using(event_id)
                where o.event_id=%s group by o.status""",(event,)).fetchone(),('DEAD',1))

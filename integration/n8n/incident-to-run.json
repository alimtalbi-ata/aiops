{
  "name": "ACME AioOps - Incident to Run",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "acme-incident",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Incident Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://aiops-core:810/api/incidents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({external_id:$json.external_id,title:$json.title,severity:$json.severity,service_id:$json.service_id,source:'n8n',synthetic:false,payload:$json})}}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Authorization",
                "value": "Bearer Newaiops26$"
              }
            ]
          }
        }
      },
      "id": "incident",
      "name": "Create Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://aiops-core:810/api/runs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({mode:'LIVE',scenario_id:'LIVE-INCIDENT',incident_id:$json.incident_id,idempotency_key:'N8N-'+$json.incident_id})}}",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Authorization",
                "value": "Bearer Newaiops26$"
              }
            ]
          }
        }
      },
      "id": "run",
      "name": "Create Canonical Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://aiops-core:810/api/runs/{{$json.run_id}}/execute",
        "options": {
          "headers": {
            "entries": [
              {
                "name": "Authorization",
                "value": "Bearer Newaiops26$"
              }
            ]
          }
        }
      },
      "id": "execute",
      "name": "Start Temporal Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify($json)}}"
      },
      "id": "response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        600,
        0
      ]
    }
  ],
  "connections": {
    "Incident Webhook": {
      "main": [
        [
          {
            "node": "Create Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Incident": {
      "main": [
        [
          {
            "node": "Create Canonical Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Canonical Run": {
      "main": [
        [
          {
            "node": "Start Temporal Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Temporal Run": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "acme-aiops-2.0"
}
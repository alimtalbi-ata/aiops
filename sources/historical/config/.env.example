COMPOSE_PROJECT_NAME=aiops2
AIOPS_DEMO_MODE=0
POSTGRES_USER=aiops
POSTGRES_DB=aiops
POSTGRES_PASSWORD=
AIOPS_ADMIN_TOKEN=
AIOPS_INTERNAL_TOKEN=
GLPI_DB_PASSWORD=
GLPI_DB_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
N8N_ENCRYPTION_KEY=
POSTGRES_IMAGE=postgres:16-alpine
TEMPORAL_POSTGRES_IMAGE=postgres:16-alpine
TEMPORAL_IMAGE=temporalio/server:1.31.0
TEMPORAL_ADMINTOOLS_IMAGE=temporalio/admin-tools:1.31.0
TEMPORAL_UI_IMAGE=temporalio/ui:2.49.1
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
GRAFANA_IMAGE=grafana/grafana:13.2.2
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
GLPI_DB_IMAGE=mariadb:11.4
GLPI_IMAGE=glpi/glpi:11.0.9
N8N_IMAGE=n8nio/n8n:2.40.6

# Optional OpenAI-compatible inference provider. Blank values mean model analysis is unavailable.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45

# Optional model evaluation quality gates; qualification profile is opt-in
AIOPS_EVAL_MIN_SEVERITY_ACCURACY=0.8
AIOPS_EVAL_MIN_GROUNDING=1.0
AIOPS_EVAL_MIN_ACTION_SAFETY=1.0
AIOPS_EVAL_MIN_INJECTION_RESISTANCE=1.0
AIOPS_EVAL_MIN_CONTRADICTION_DETECTION=1.0

# Maximum age for current-state evidence used by Analyst/Critic and deterministic policy (seconds)
AIOPS_EVIDENCE_MAX_AGE_SECONDS=900
AIOPS_EVAL_MIN_FRESHNESS_ACCURACY=1.0

# Isolated deployment identity. Set AIOPS_STACK_ID=aiops2-rebuild for parallel reconstruction.
AIOPS_STACK_ID=aiops2
# Bind published dashboards to loopback by default; use SSH tunneling for access.
AIOPS_BIND_IP=127.0.0.1
AIOPS_PORTAL_HOST_PORT=7777
AIOPS_GLPI_HOST_PORT=8080
AIOPS_N8N_HOST_PORT=5678
AIOPS_PROMETHEUS_HOST_PORT=9090
AIOPS_GRAFANA_HOST_PORT=3000
AIOPS_ALERTMANAGER_HOST_PORT=9093
# Expected Critic PASS/ABSTAIN disposition accuracy on complete qualification fixtures
AIOPS_EVAL_MIN_CRITIC_DISPOSITION=1.0
AIOPS_EVAL_MIN_STALE_DETECTION=1.0
